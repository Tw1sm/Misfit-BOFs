alias ts-tasklist{
    $bid = $1;
	if( size(@_) < 2)
	{
		berror($1, "requires target host");
		berror($1, beacon_command_detail("ts-tasklist"));
		return;
	}
    	
    # Read in the right BOF file
    $handle = openf(script_resource("dist/ts-tasklist." . barch($bid) . ".o"));
    $data = readb($handle, -1);
    closef($handle);

    # Pack our arguments
    $arg_data  = bof_pack($bid, "Z", $2);
    
    btask($bid, "Tasking remote tasklist via terminal services");
    beacon_inline_execute($bid, $data, "go", $arg_data);
}

beacon_command_register(
	"ts-tasklist",
	"Query process listing on remote host through RPC calls (requires terminal services)",
	"ts-tasklist <target_host>"
);